{
  "version": 2,
  "builds": [
    {
      "src": "petcare360/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "petcare360/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "petcare360.settings",
    "PYTHONUNBUFFERED": "1",
    "ALLOWED_HOSTS": "petcare360-mocha.vercel.app,localhost,127.0.0.1",
    "CSRF_TRUSTED_ORIGINS": "https://petcare360-mocha.vercel.app,https://*.vercel.app"
  }
}
